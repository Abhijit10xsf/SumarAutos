@model SumarAuto.Data.Entities.User
@{
    ViewBag.Title = "B2B Registration | TradeParts Wholesale";
}

<main class="container-fluid px-xl-4 py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-7">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="card-header bg-dark text-white p-4 d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center gap-2">
                        <span class="brand-mark" style="width: 38px; height: 38px; font-size: 1.1rem;">T</span>
                        <div>
                            <h1 class="h4 mb-0 fw-bold text-white">B2B Dealer Registration</h1>
                            <small class="text-white-50">Join our network of verified UAE automotive wholesalers</small>
                        </div>
                    </div>
                    <span class="badge text-bg-danger px-3 py-2 rounded-pill">Wholesale Portal</span>
                </div>
                <div class="card-body p-4 p-md-5">
                    @if (ViewBag.ErrorMessage != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i> @ViewBag.ErrorMessage
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    @using (Html.BeginForm("Register", "Account", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label fw-semibold">Company Name *</label>
                                <input type="text" name="CompanyName" class="form-control form-control-lg" placeholder="e.g. Al Khaleej Auto Parts LLC" value="@Model.CompanyName" required>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Contact Person Name *</label>
                                <input type="text" name="ContactPerson" class="form-control" placeholder="e.g. Ahmed Al Mansoori" value="@Model.ContactPerson" required>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Mobile / Phone Number *</label>
                                <input type="text" name="Phone" class="form-control" placeholder="+971 50 123 4567" value="@Model.Phone" required>
                            </div>

                            <div class="col-12">
                                <label class="form-label fw-semibold">Official Business Email *</label>
                                <input type="email" name="Email" class="form-control" placeholder="wholesale@company.ae" value="@Model.Email" required>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold">TRN Number (VAT Registration)</label>
                                <input type="text" name="TrnNumber" class="form-control" placeholder="100293847500003" value="@Model.TrnNumber">
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Trade License Number</label>
                                <input type="text" name="TradeLicenseNumber" class="form-control" placeholder="CN-1928472" value="@Model.TradeLicenseNumber">
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Password *</label>
                                <input type="password" name="Password" class="form-control" placeholder="••••••••" required>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Confirm Password *</label>
                                <input type="password" name="confirmPassword" class="form-control" placeholder="••••••••" required>
                            </div>

                            <div class="col-12">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="termsAgree" required checked>
                                    <label class="form-check-label small text-muted" for="termsAgree">
                                        I certify that I am authorized to represent this company and agree to TradeParts B2B Terms of Service.
                                    </label>
                                </div>
                            </div>

                            <div class="col-12 mt-4 d-flex justify-content-between align-items-center flex-wrap gap-3">
                                <a href="@Url.Action("Login", "Account")" class="text-danger fw-bold">
                                    <i class="bi bi-arrow-left me-1"></i> Already registered? Sign In
                                </a>
                                <button type="submit" class="btn btn-danger btn-lg px-5 py-3 fw-bold rounded-3 shadow">
                                    <i class="bi bi-person-check-fill me-2"></i> Register Account
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</main>
