@model SumarAuto.Client.Models.LoginVM

@{
    ViewBag.Title = "B2B Dealer Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SumarAuto - B2B Wholesale Portal Login</title>

    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>
        :root {
            --brand: #ed2f24;
            --brand-dark: #c91f16;
            --ink: #162130;
            --muted: #6c7785;
            --surface: #ffffff;
            --page: #f3f5f8;
            --line: #e4e8ee;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            background: radial-gradient(circle at 10% 20%, rgba(237, 47, 36, 0.08), transparent 35%),
                        radial-gradient(circle at 90% 80%, rgba(22, 33, 48, 0.06), transparent 40%),
                        var(--page);
            font-family: "Inter", system-ui, -apple-system, sans-serif;
            color: var(--ink);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1.5rem 1rem;
        }

        .login-wrapper {
            width: 100%;
            max-width: 440px;
        }

        .login-card {
            background: var(--surface);
            border: 1px solid var(--line);
            border-radius: 20px;
            box-shadow: 0 20px 40px rgba(22, 33, 48, 0.08), 0 2px 6px rgba(0, 0, 0, 0.04);
            overflow: hidden;
            transition: transform 0.25s ease, box-shadow 0.25s ease;
        }

        .brand-header {
            background: linear-gradient(135deg, #161b22 0%, #24282d 100%);
            padding: 2.2rem 2rem;
            text-align: center;
            color: #ffffff;
            position: relative;
        }

        .brand-header::after {
            content: "";
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: linear-gradient(90deg, var(--brand), #ff6b63);
        }

        .brand-mark {
            display: inline-grid;
            place-items: center;
            width: 52px;
            height: 52px;
            border-radius: 14px;
            background: var(--brand);
            color: #ffffff;
            font-size: 24px;
            font-weight: 800;
            margin-bottom: 0.75rem;
            box-shadow: 0 8px 18px rgba(237, 47, 36, 0.35);
            transition: transform 0.3s ease;
        }

        .brand-mark:hover {
            transform: scale(1.06) rotate(-3deg);
        }

        .brand-title {
            font-size: 22px;
            font-weight: 800;
            letter-spacing: -0.02em;
            margin: 0;
        }

        .brand-subtitle {
            font-size: 13px;
            color: rgba(255, 255, 255, 0.7);
            margin-top: 4px;
            font-weight: 500;
        }

        .card-body-custom {
            padding: 2.2rem 2rem;
        }

        .form-label {
            font-size: 13px;
            font-weight: 600;
            color: var(--ink);
            margin-bottom: 6px;
        }

        .input-group-custom {
            position: relative;
            border: 1px solid var(--line);
            border-radius: 12px;
            background: #fafbfc;
            transition: border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
            overflow: hidden;
        }

        .input-group-custom:focus-within {
            border-color: var(--brand);
            background: #ffffff;
            box-shadow: 0 0 0 3px rgba(237, 47, 36, 0.12);
        }

        .input-group-text-icon {
            border: none;
            background: transparent;
            color: var(--muted);
            padding: 0.75rem 1rem;
            display: flex;
            align-items: center;
            font-size: 1.1rem;
        }

        .form-control-custom {
            border: none;
            background: transparent;
            padding: 0.75rem 1rem 0.75rem 0;
            font-size: 14px;
            font-weight: 500;
            color: var(--ink);
            width: 100%;
        }

        .form-control-custom:focus {
            outline: none;
            box-shadow: none;
        }

        .password-toggle {
            cursor: pointer;
            padding: 0.75rem 1rem;
            color: var(--muted);
            transition: color 0.2s ease;
            display: flex;
            align-items: center;
        }

        .password-toggle:hover {
            color: var(--ink);
        }

        .btn-brand-login {
            background: linear-gradient(135deg, var(--brand) 0%, var(--brand-dark) 100%);
            color: #ffffff;
            font-weight: 700;
            font-size: 15px;
            padding: 0.85rem 1.5rem;
            border-radius: 12px;
            border: none;
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            box-shadow: 0 8px 20px rgba(237, 47, 36, 0.28);
            transition: all 0.2s ease;
            margin-top: 1.5rem;
        }

        .btn-brand-login:hover {
            background: linear-gradient(135deg, #f4382e 0%, #b81b12 100%);
            color: #ffffff;
            transform: translateY(-1px);
            box-shadow: 0 10px 24px rgba(237, 47, 36, 0.38);
        }

        .btn-brand-login:active {
            transform: translateY(0);
            box-shadow: 0 4px 12px rgba(237, 47, 36, 0.25);
        }

        .sap-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: rgba(22, 33, 48, 0.05);
            border: 1px solid rgba(22, 33, 48, 0.08);
            color: var(--muted);
            font-size: 12px;
            font-weight: 600;
            padding: 6px 14px;
            border-radius: 20px;
            margin-top: 1.8rem;
        }

        .sap-badge i {
            color: var(--brand);
        }

        #loaderOverlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(22, 33, 48, 0.4);
            backdrop-filter: blur(4px);
            z-index: 9999;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .spinner-custom {
            width: 50px;
            height: 50px;
            border: 4px solid rgba(255, 255, 255, 0.3);
            border-top: 4px solid var(--brand);
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
        }

        @@keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
    </style>
</head>

<body>
    <!-- Fullscreen Loader Overlay -->
    <div id="loaderOverlay" style="display:none;">
        <div class="text-center">
            <div class="spinner-custom mb-3"></div>
            <div class="text-white fw-bold small">Authenticating with SAP B1...</div>
        </div>
    </div>

    <div class="login-wrapper">
        <div class="login-card">
            <!-- Brand Header -->
            <div class="brand-header">
                <div class="brand-mark">S</div>
                <h1 class="brand-title">SumarAuto</h1>
                <div class="brand-subtitle">Wholesale Automotive Spare Parts - B2B Partner Portal</div>
            </div>

            <!-- Card Body / Login Form -->
            <div class="card-body-custom">
                <div id="loginSection">
                    <div class="mb-3.5">
                        <label class="form-label">Username / SAP Account ID</label>
                        <div class="input-group-custom d-flex align-items-center">
                            <span class="input-group-text-icon"><i class="bi bi-person"></i></span>
                            @Html.TextBoxFor(m => m.UserName, new { @class = "form-control-custom", placeholder = "Enter your SAP username", id = "UserName", autocomplete = "username" })
                        </div>
                    </div>

                    <div class="mt-3 mb-2">
                        <label class="form-label">Password</label>
                        <div class="input-group-custom d-flex align-items-center">
                            <span class="input-group-text-icon"><i class="bi bi-lock"></i></span>
                            @Html.PasswordFor(m => m.Password, new { @class = "form-control-custom", placeholder = "Enter your password", id = "Password", autocomplete = "current-password" })
                            <span class="password-toggle" id="togglePasswordBtn">
                                <i class="bi bi-eye" id="togglePasswordIcon"></i>
                            </span>
                        </div>
                    </div>

                    <button type="button" id="loginBtn" class="btn-brand-login">
                        <span>Sign In to B2B Portal</span>
                        <i class="bi bi-arrow-right-short fs-5"></i>
                    </button>
                </div>

                <!-- Footer Badge -->
                <div class="text-center">
                    <div class="sap-badge">
                        <i class="bi bi-shield-check"></i>
                        <span>Powered by SAP B1 HANA Service Layer</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        function showLoader() {
            $("#loaderOverlay").fadeIn(200);
        }

        function hideLoader() {
            $("#loaderOverlay").fadeOut(200);
        }

        function showMessage(msg, type = "error") {
            let title = type === "success" ? "Success" : (type === "warning" ? "Warning" : "Authentication Failed");
            let icon = type;

            Swal.fire({
                title: title,
                text: msg,
                icon: icon,
                confirmButtonColor: "#ed2f24",
                customClass: {
                    popup: 'border-0 shadow-lg rounded-4'
                }
            });
        }

        // Toggle Password Visibility
        $("#togglePasswordBtn").click(function () {
            let passInput = $("#Password");
            let icon = $("#togglePasswordIcon");
            if (passInput.attr("type") === "password") {
                passInput.attr("type", "text");
                icon.removeClass("bi-eye").addClass("bi-eye-slash");
            } else {
                passInput.attr("type", "password");
                icon.removeClass("bi-eye-slash").addClass("bi-eye");
            }
        });

        // LOGIN SUBMIT
        $("#loginBtn").click(function () {
            let username = $("#UserName").val().trim();
            let password = $("#Password").val();

            if (!username || !password) {
                showMessage("Please enter both Username and Password.", "warning");
                return;
            }

            showLoader();

            $.post('@Url.Action("Login", "Account")', {
                UserName: username,
                Password: password
            }, function (res) {
                hideLoader();
                if (res.success) {
                    window.location.href = '@Url.Action("Index", "Home")';
                } else {
                    showMessage(res.message || "Invalid SAP B1 username or password.", "error");
                }
            }).fail(function () {
                hideLoader();
                showMessage("Unable to communicate with authentication service. Please check connection.", "error");
            });
        });

        // ENTER KEY TRIGGER
        $(document).on("keypress", function (e) {
            if (e.which === 13) {
                $("#loginBtn").click();
            }
        });
    </script>
</body>
</html>